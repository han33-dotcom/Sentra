# Copy to .env (never commit .env). Used by docker-compose.yml.

# Image to run. Local build by default; the CI publishes ghcr.io/<org>/<repo>/backend:latest on every merge to main.
BACKEND_IMAGE=sentra-backend:local
# BACKEND_IMAGE=ghcr.io/sentra-fyp/sentra/backend:latest

# Folder with client_secret.json, whoop_client.json and tokens/ (absolute path on Windows is fine)
SECRETS_DIR=./wearables-pipeline/secrets

# Long random string; every /api/v1 call needs header  X-API-Key: <this>
# PowerShell:  -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
WP_API_KEY=change-me
API_PORT=8000

# How the worker keeps the backend current
WP_SYNC_EVERY_MIN=15          # full pull from every connected device
WP_PROCESS_MIN_GAP_MIN=60     # rebuild processed outputs at most this often (only when data changed)
WP_BACKFILL_DAYS=30           # history pulled for a newly connected person
WP_OVERLAP_HOURS=6            # re-read window for late phone syncs

# Optional: public URL for WHOOP webhooks (docker compose --profile public up -d)
CLOUDFLARE_TUNNEL_TOKEN=
