# Copy to .env (ignored by git). Never commit real values.
# 32+ random characters, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
SENTRA_API_KEY=
# Single-line JSON with viewer-only credentials:
# {"confirmed_free_plan":true,"url":"https://<ref>.supabase.co","publishable_key":"...","storage_email":"...",
#  "storage_password":"...","certificate_pem":"-----BEGIN CERTIFICATE-----\n...","limits":{...},
#  "db":{"host":"...pooler.supabase.com","port":5432,"dbname":"postgres","user":"sentra_viewer.<ref>","password":"..."}}
SENTRA_PROCESSING_CONFIG=
SENTRA_PROCESS_INTERVAL_HOURS=24
API_PORT=8000
# Separate enrollment service only; see docs/self-service-enrollment.md.
SENTRA_ENROLLMENT_CONFIG=
SENTRA_ENROLLMENT_CA_FILE=
SENTRA_ENROLLMENT_PROXY_IPS=127.0.0.1
ENROLLMENT_PORT=8010
